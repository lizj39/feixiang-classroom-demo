{
  "name": "feixiang-classroom-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "老师一句话 -> 选择 Skill -> 生成可操作课件（可解释、可验证、可定位）",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "vite build",
    "start": "tsx src/server/main.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run",
    "demo:llm": "tsx scripts/demo-llm.ts",
    "check:clean": "node scripts/check-clean.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
